# Copilot backend configuration template.
#
# Copy to `.env` and edit for your local deployment. Every variable is
# namespaced `COPILOT_` to keep it isolated from anything else on the box.
# `pydantic-settings` reads this file via app/settings.py.

# ---- CORS ---------------------------------------------------------------
# Comma-separated origins allowed by CORS middleware. SPEC defers the
# prod policy to V1.1; the default (http://localhost:3000) is the
# local Vite dev server. Override in deployments.
# COPILOT_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- MongoDB ------------------------------------------------------------
# Used by T04 / T05 / T39 / T42 to talk to the document store. T03 only
# TCP-pings this URI to populate /healthz.
# COPILOT_MONGODB_URI=mongodb://localhost:27017
# Logical database the four core collections live in. Override per env.
# COPILOT_MONGODB_DATABASE=copilot
# Motor server-selection timeout (ms). Mirrors /healthz probe budget.
# COPILOT_MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# ---- Milvus -------------------------------------------------------------
# gRPC host + port. T03 TCP-pings; T31 writes long-term memory here.
# COPILOT_MILVUS_HOST=localhost
# COPILOT_MILVUS_PORT=19530

# ---- Langfuse ------------------------------------------------------------
# Langfuse manages LLM prompts and trace ingestion. T03 probes its public
# /health; T35 (langfuse SDK) wires the OTel/ingest endpoints. The host
# must NOT include a trailing slash.
# COPILOT_LANGFUSE_HOST=https://langfuse.bananahochoy.online

# ---- Health probes ------------------------------------------------------
# Per-dependency probe timeout (seconds). Used by /healthz and the
# lifespan startup probe. Range: 0.1–10.0.
# COPILOT_HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# ---- Credential encryption (T05 / #6) -----------------------------------
# Master key used to seal Tool credentials at rest (ADR-0002). Two
# accepted forms:
#   * base64-encoded 32-byte literal — preferred for production.
#     Generate with: `python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"`
#   * human-readable passphrase — dev convenience. The bytes are
#     derived via PBKDF2-HMAC-SHA256 using `COPILOT_CREDENTIAL_ENCRYPTION_SALT`.
#     The factory detects which form is in use; the .env.example ships
#     a passphrase so the file stays readable.
# COPILOT_CREDENTIAL_ENCRYPTION_KEY=dev-only-do-not-use-in-prod
# PBKDF2 salt for passphrase-derived keys. Must be at least 16 bytes
# after UTF-8 encoding (so 16 ASCII chars is the floor). Fixed in dev
# so restarts decrypt existing rows. Rotate together with the key when
# moving between environments.
# COPILOT_CREDENTIAL_ENCRYPTION_SALT=copilot-dev-salt-001
